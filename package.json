{
  "name": "lsi-os",
  "version": "1.0.0",
  "private": true,
  "description": "Life Sciences Intelligence OS — AI-native platform for pharma, biotech, and healthcare",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "npm run build --workspace=apps/web",
    "seed": "cd apps/api && python -m app.db.seed",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  }
}
