# Copy to .env and fill as needed

# Database — SQLite for local; Postgres when using Docker Compose
DATABASE_URL=sqlite:///./lsi_os.db
# DATABASE_URL=postgresql+psycopg://lsi:lsi_secret@localhost:5432/lsi_os
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-lsi-os-2024
JWT_EXPIRE_MINUTES=10080

# Object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lsi_minio
MINIO_SECRET_KEY=lsi_minio_secret
MINIO_BUCKET=lsi-documents
MINIO_SECURE=false

# LLM / embeddings (set on Vercel; never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-3-5-haiku-latest
JWT_SECRET=change-me-in-production-lsi-os-2024

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

SEED_ON_STARTUP=true
