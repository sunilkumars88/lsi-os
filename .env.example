# EIOS production environment template — copy to .env (never commit secrets)

# --- Database / cache / object storage ---
DATABASE_URL=postgresql://eios:eios_secret@localhost:5432/eios
# AI service may use SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://eios:eios_secret@localhost:5432/eios
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=eios_minio
MINIO_SECRET_KEY=eios_minio_secret
MINIO_BUCKET=eios-documents
MINIO_SECURE=false

# --- Auth ---
JWT_SECRET=change-me-in-production-eios-2026
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_DAYS=7
SEED_ON_STARTUP=true

# --- OpenAI only (required for production LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=auto

# --- Service URLs ---
PORT=4000
AI_SERVICE_URL=http://localhost:8000
NEST_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Email (magic link + invitations) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@eios.local
# Or Resend:
# RESEND_API_KEY=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback

# --- Connectors (optional; sandbox works without these) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SLACK_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
